@using BasketWorld.Models
@using Microsoft.AspNetCore.Identity
@model IEnumerable<ApplicationUser>
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-page">

    <header class="admin-header">
        <div>
            <h1 class="admin-title">Dashboard Admin</h1>
            <p class="admin-subtitle">Synchronisation des ligues + gestion des utilisateurs.</p>
        </div>
    </header>

    @if (TempData["err"] != null)
    {
        <div class="notice notice-danger">
            <div class="notice-title">Erreur</div>
            <div class="notice-text">@TempData["err"]</div>
        </div>
    }
    @if (TempData["msg"] != null)
    {
        <div class="notice notice-success">
            <div class="notice-title">OK</div>
            <div class="notice-text">@TempData["msg"]</div>
        </div>
    }

    <div class="grid">

        <!-- NBA -->
        <section class="cardx">
            <div class="cardx-head">
                <div>
                    <h2 class="cardx-title">Synchronisation NBA</h2>
                    <div class="cardx-desc">Balldontlie → remplissage matchs et scores si disponibles.</div>
                </div>
                <span class="tag tag-orange">SYNC</span>
            </div>

            <div class="actions">
                <a class="btnx btnx-outline"
                   asp-area="Admin" asp-controller="Dashboard" asp-action="SyncNba"
                   asp-route-past="7" asp-route-next="7" asp-route-mode="expand" asp-route-minMatches="5">
                    Syncro NBA
                </a>
                <a class="btnx btnx-outline"
                    asp-area="Admin" asp-controller="Dashboard" asp-action="SyncNbaSeason"
                    asp-route-season="2025">
                    Sync NBA — Saison 2025
                </a>
            </div>
        </section>

        <!-- EuroLeague -->
        <section class="cardx">
            <div class="cardx-head">
                <div>
                    <h2 class="cardx-title">Synchronisation EuroLeague</h2>
                    <div class="cardx-desc">TheSportsDB + API officielle Euroleague (schedule + stats/score).</div>
                </div>
                <span class="tag tag-blue">EURO</span>
            </div>

            <div class="actions">
                <form asp-action="SyncEuroleagueTeams" method="post" class="d-inline">
                    <button type="submit" class="btnx btnx-outline-blue">
                        Sync Teams
                    </button>
                </form>

                <form asp-action="SyncEuroleagueSeason" method="post" class="inline-form">
                    <input type="text"
                           name="season"
                           value="2025"
                           class="inputx"
                           placeholder="Saison (ex: 2025)" />
                    <button type="submit" class="btnx btnx-green">
                        Sync Saison
                    </button>
                </form>

                <form asp-action="SyncEuroleagueOfficial" method="post" class="d-inline">
                    <input type="hidden" name="seasonCode" value="E2025" />
                    <button type="submit" class="btnx btnx-blue">
                        Sync API officielle (E2025)
                    </button>
                </form>
            </div>
        </section>

    </div>

    <!-- Liste utilisateurs -->
    <section class="cardx mt-3">
        <div class="cardx-head">
            <div>
                <h2 class="cardx-title">Gestion des utilisateurs</h2>
                <div class="cardx-desc">Modifier les rôles et les crédits</div>
            </div>
            <span class="tag tag-soft">USERS</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty">
                <div class="empty-title">Aucun utilisateur trouvé</div>
            </div>
        }
        else
        {
            <div class="users-list">
                <div class="users-table-wrapper">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th>Utilisateur</th>
                                <th>Email</th>
                                <th>Rôle</th>
                                <th>Crédits</th>
                                <th>Inscrit</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                var roles = await UserManager.GetRolesAsync(user);
                                var role = roles.FirstOrDefault() ?? "user";
                                
                                <tr>
                                    <td class="user-name">
                                        <strong>@(user.FullName ?? user.UserName)</strong>
                                    </td>
                                    <td class="user-email">@user.Email</td>
                                    <td>
                                        <span class="badge badge-@(role == "admin" ? "orange" : "soft")">
                                            @role.ToUpper()
                                        </span>
                                    </td>
                                    <td class="user-credits">
                                        <strong>@user.crédits</strong>
                                    </td>
                                    <td class="user-date">
                                        @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="user-actions">
                                        <button type="button" class="edit-btn" 
                                                data-user-id="@user.Id" 
                                                data-user-name="@user.UserName"
                                                data-user-role="@role"
                                                data-user-credits="@user.crédits"
                                                onclick="openUserModal(this)">
                                            Modifier
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <!-- Modal Modification Utilisateur -->
    <div class="modal" id="userModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalTitle">Modifier utilisateur</h3>
                <button type="button" class="modal-close" onclick="closeUserModal()">&times;</button>
            </div>
            
            <div class="modal-body">
                <form id="editUserForm" method="post" asp-area="Admin" asp-controller="Dashboard" asp-action="UpdateUser">
                    <input type="hidden" id="userId" name="userId" />
                    
                    <div class="form-group">
                        <label for="userRole">Rôle</label>
                        <select id="userRole" name="newRole" class="form-control">
                            <option value="">Utilisateur</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label for="userCredits">Crédits</label>
                        <input type="number" id="userCredits" name="creditAmount" min="0" class="form-control" />
                    </div>
                    
                    <div class="modal-actions">
                        <button type="submit" class="btnx btnx-green">
                            Mettre à jour
                        </button>
                        <button type="button" class="btnx btnx-outline" onclick="closeUserModal()">
                            Annuler
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

<script>
    function openUserModal(btn) {
        const userId = btn.getAttribute('data-user-id');
        const userName = btn.getAttribute('data-user-name');
        const userRole = btn.getAttribute('data-user-role');
        const userCredits = btn.getAttribute('data-user-credits');
        
        document.getElementById('modalTitle').textContent = `Modifier ${userName}`;
        document.getElementById('userId').value = userId;
        document.getElementById('userRole').value = userRole === 'admin' ? 'admin' : '';
        document.getElementById('userCredits').value = userCredits;
        
        document.getElementById('userModal').classList.add('active');
    }
    
    function closeUserModal() {
        document.getElementById('userModal').classList.remove('active');
    }
    
    // Fermer la modale en cliquant en dehors
    document.getElementById('userModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeUserModal();
        }
    });
</script>



<style>
    :root { --orange: var(--orange, #ff8c00); }

    .admin-page{
        padding: 1.25rem 0 2rem;
        color: #f8f9fa;
    }

    .admin-header{
        display:flex;
        align-items:flex-end;
        justify-content:space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .admin-title{
        font-weight: 900;
        letter-spacing: .02em;
        margin:0;
        color: #fff;
    }

    .admin-subtitle{
        margin:.35rem 0 0;
        color: rgba(249,250,251,.78);
    }

    .admin-badges{ display:flex; gap:.5rem; flex-wrap:wrap; }

    .pill{
        padding:.35rem .75rem;
        border-radius:999px;
        border:1px solid rgba(255,255,255,.12);
        background: rgba(15,23,42,.55);
        font-weight: 800;
        font-size:.78rem;
        letter-spacing:.06em;
        text-transform: uppercase;
        color: rgba(249,250,251,.9);
    }
    .pill-soft{ border-color: rgba(255,140,0,.25); background: rgba(255,140,0,.10); color:#ffd6a5; }

    .grid{
        display:grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .cardx{
        border-radius: 1.25rem;
        overflow:hidden;
        background: #0b1120;
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 14px 30px rgba(0,0,0,.25);
    }

    .cardx-head{
        padding: 1.1rem 1.2rem;
        background: linear-gradient(135deg, #111827, #0b1220 55%, #1f2937);
        border-bottom: 1px solid rgba(255,255,255,.08);
        display:flex;
        align-items:flex-start;
        justify-content:space-between;
        gap:1rem;
        position:relative;
    }
    .cardx-head::before{
        content:"";
        position:absolute;
        inset:0;
        background-image:
            radial-gradient(circle at 10% 10%, rgba(255,140,0,.18) 0, transparent 55%),
            radial-gradient(circle at 85% 90%, rgba(59,130,246,.16) 0, transparent 55%);
        opacity:.9;
        pointer-events:none;
    }
    .cardx-head > *{ position:relative; z-index:1; }

    .cardx-title{ margin:0; font-weight:900; color:#fff; }
    .cardx-desc{ margin-top:.25rem; color: rgba(249,250,251,.75); }

    .tag{
        border-radius:999px;
        padding:.35rem .7rem;
        font-weight:900;
        font-size:.75rem;
        letter-spacing:.08em;
        text-transform: uppercase;
        border:1px solid rgba(255,255,255,.10);
        background: rgba(15,23,42,.55);
        color: rgba(249,250,251,.85);
        white-space:nowrap;
    }
    .tag-orange{ border-color: rgba(255,140,0,.30); background: rgba(255,140,0,.12); color:#ffd6a5; }
    .tag-blue{ border-color: rgba(59,130,246,.30); background: rgba(59,130,246,.12); color:#bfdbfe; }
    .tag-soft{ border-color: rgba(148,163,184,.25); background: rgba(148,163,184,.10); color: rgba(249,250,251,.85); }

    .actions{
        padding: 1rem 1.2rem 1.2rem;
        display:flex;
        flex-wrap:wrap;
        gap: .6rem;
        align-items:center;
    }

    .btnx{
        border-radius: 999px;
        padding: .65rem .95rem;
        font-weight: 900;
        letter-spacing:.04em;
        text-transform: uppercase;
        font-size: .78rem;
        border: 1px solid rgba(255,255,255,.14);
        background: rgba(15,23,42,.35);
        color: rgba(249,250,251,.9);
        text-decoration:none;
        display:inline-flex;
        align-items:center;
        gap:.5rem;
    }
    .btnx:hover{ filter: brightness(1.05); color:#fff; }

    .btnx-orange{ background: var(--orange); border-color: var(--orange); color:#111; }
    .btnx-orange:hover{ color:#111; }

    .btnx-green{ background:#10b981; border-color:#10b981; color:#062016; }
    .btnx-green:hover{ color:#062016; }

    .btnx-blue{ background:#2563eb; border-color:#2563eb; color:#fff; }
    .btnx-blue:hover{ color:#fff; }

    .btnx-outline{
        background: transparent;
        border-color: rgba(255,140,0,.45);
        color:#ffd6a5;
    }
    .btnx-outline:hover{ background: rgba(255,140,0,.10); }

    .btnx-outline-blue{
        background: transparent;
        border-color: rgba(59,130,246,.45);
        color:#bfdbfe;
    }
    .btnx-outline-blue:hover{ background: rgba(59,130,246,.10); }

    .inline-form{
        display:flex;
        gap:.5rem;
        align-items:center;
        flex-wrap:wrap;
    }

    .inputx{
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        color:#fff;
        border-radius: 999px;
        padding: .6rem .9rem;
        width: 160px;
        outline:none;
    }

    .muted{ color: rgba(249,250,251,.7); }

    .notice{
        border-radius: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid rgba(255,255,255,.08);
        margin-bottom: 1rem;
        background: rgba(15,23,42,.55);
    }
    .notice-title{ font-weight: 900; margin-bottom:.2rem; }
    .notice-text{ color: rgba(249,250,251,.82); }

    .notice-danger{ border-color: rgba(239,68,68,.25); background: rgba(239,68,68,.10); }
    .notice-success{ border-color: rgba(16,185,129,.25); background: rgba(16,185,129,.10); }

    .empty{
        padding: 1.25rem 1.2rem 1.35rem;
        color: rgba(249,250,251,.85);
    }
    .empty-title{ font-weight: 900; margin-bottom:.25rem; }
    .empty-text{ color: rgba(249,250,251,.70); }

    /* Users list */
    .users-list { padding: 0; }
    
    .users-table-wrapper {
        overflow-x: auto;
    }
    
    .users-table {
        width: 100%;
        border-collapse: collapse;
        background: transparent;
    }
    
    .users-table thead {
        background: rgba(15,23,42,.55);
        border-bottom: 1px solid rgba(255,255,255,.08);
    }
    
    .users-table th {
        padding: 1rem 1.2rem;
        text-align: left;
        font-weight: 900;
        font-size: .85rem;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: rgba(249,250,251,.85);
    }
    
    .users-table tbody tr {
        border-bottom: 1px solid rgba(255,255,255,.06);
        transition: background 0.15s ease;
    }
    
    .users-table tbody tr:hover {
        background: rgba(15,23,42,.35);
    }
    
    .users-table td {
        padding: 1rem 1.2rem;
        color: rgba(249,250,251,.85);
    }
    
    .user-name {
        font-weight: 600;
        color: #fff;
    }
    
    .user-email {
        font-size: .9rem;
        color: rgba(249,250,251,.75);
    }
    
    .user-credits {
        color: #ffd6a5;
        font-size: 1.05rem;
    }
    
    .user-date {
        font-size: .9rem;
        color: rgba(249,250,251,.7);
    }
    
    .user-actions {
        white-space: nowrap;
    }
    
    .edit-btn {
        background: rgba(255,140,0,.15);
        border: 1px solid rgba(255,140,0,.30);
        color: #ffd6a5;
        padding: .45rem .75rem;
        border-radius: .6rem;
        font-weight: 700;
        font-size: .8rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    
    .edit-btn:hover {
        background: rgba(255,140,0,.25);
        border-color: rgba(255,140,0,.50);
    }
    
    .badge {
        display: inline-block;
        padding: .35rem .65rem;
        border-radius: 999px;
        font-weight: 900;
        font-size: .75rem;
        letter-spacing: .04em;
        text-transform: uppercase;
        border: 1px solid rgba(255,255,255,.10);
        background: rgba(148,163,184,.10);
        color: rgba(249,250,251,.85);
    }
    
    .badge-orange {
        background: rgba(255,140,0,.12);
        border-color: rgba(255,140,0,.30);
        color: #ffd6a5;
    }
    
    .badge-soft {
        background: rgba(148,163,184,.10);
        border-color: rgba(148,163,184,.25);
        color: rgba(249,250,251,.85);
    }

    /* Modal */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
    }
    
    .modal.active {
        display: flex;
    }
    
    .modal-content {
        background: #0b1120;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 1.25rem;
        box-shadow: 0 20px 50px rgba(0,0,0,.5);
        width: 90%;
        max-width: 420px;
        animation: slideIn 0.3s ease;
    }
    
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .modal-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,.08);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .modal-header h3 {
        margin: 0;
        font-weight: 900;
        color: #fff;
    }
    
    .modal-close {
        background: none;
        border: none;
        color: rgba(249,250,251,.7);
        font-size: 1.8rem;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.15s ease;
    }
    
    .modal-close:hover {
        color: #fff;
    }
    
    .modal-body {
        padding: 1.5rem;
    }
    
    .form-group {
        margin-bottom: 1.25rem;
    }
    
    .form-group label {
        display: block;
        margin-bottom: .5rem;
        font-weight: 700;
        color: #fff;
        font-size: .9rem;
    }
    
    .form-control {
        width: 100%;
        padding: .75rem;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: .6rem;
        color: #fff;
        font-family: inherit;
        font-size: .95rem;
        outline: none;
        transition: all 0.15s ease;
    }
    
    .form-control:focus {
        background: rgba(255,255,255,.10);
        border-color: rgba(255,140,0,.30);
        color: #fff;
    }
    
    .modal-actions {
        display: flex;
        gap: .75rem;
        margin-top: 1.5rem;
    }
    
    .modal-actions button {
        flex: 1;
    }

    @@media (max-width: 1100px){
        .grid{ grid-template-columns: 1fr; }
    }

    @@media (max-width: 650px){
        .admin-header{ flex-direction:column; align-items:flex-start; }
        .users-table-wrapper {
            overflow-x: auto;
        }
        .users-table {
            min-width: 600px;
        }
        .modal-content {
            width: 95%;
        }
    }
</style>
