@model BasketWorld.Models.ViewModels.LeaguePageViewModel
@{
    ViewData["Title"] = Model.LeagueName;

    string HomeHero(dynamic g) => g?.HomeTeam?.HeroImageUrl ?? Url.Content("~/images/team-bg/default-home.png");
    string AwayHero(dynamic g) => g?.AwayTeam?.HeroImageUrl ?? Url.Content("~/images/team-bg/default-away.png");

    // ➜ Alias d’affichage pour les noms trop longs
    string ShortTeamName(string? raw)
    {
      if (string.IsNullOrWhiteSpace(raw)) return "";

      return raw.ToUpperInvariant() switch
      {
          "ANADOLU EFES ISTANBUL" => "Anadolu",
          "AS MONACO" => "Monaco",
          "KOSNER BASKONIA VITORIA-GASTEIZ" => "Baskonia",
          "FC BAYERN MUNICH" => "Bayern",
          "ZALGIRIS KAUNAS" => "Zalgiris",
          "FC BARCELONA" => "Barcelona",
          "DUBAI BASKETBALL" => "Dubai",
          "FENERBAHCE BEKO ISTANBUL" => "Fenerbahce",
          "HAPOEL IBI TEL AVIV" => "Hapoel",
          "PARTIZAN MOZZART BET BELGRADE" => "Partizan",
          "LDLC ASVEL VILLEURBANNE" => "ASVEL",
          "MACCABI RAPYD TEL AVIV" => "Maccabi",
          "EA7 EMPORIO ARMANI MILAN" => "Milano", // ou "Olimpia Milano"
          "OLYMPIACOS PIRAEUS" => "Olympiacos",
          "PANATHINAIKOS AKTOR ATHENS" => "Panathinaikos",
          "CRVENA ZVEZDA MERIDIANBET BELGRADE" => "Crvena",
          "PARIS BASKETBALL" => "Paris",
          "REAL MADRID" => "Real Madrid",
          "VALENCIA BASKET" => "Valencia",
          "VIRTUS BOLOGNA" => "Bologna",
          "MERIDIANS" => "Meridians",
          _ => raw
      };
    }
}

<!--<h1 class="mb-4" style="color: var(--orange)">@Model.LeagueName</h1>-->

@if (Model.Teams?.Any() == true)
{
    <div class="logo-carousel-wrapper mb-5">
        <button class="carousel-btn left" type="button" aria-label="Défiler vers la gauche">‹</button>

        <div class="logo-carousel" id="logoCarousel">
            @foreach (var team in Model.Teams)
            {
                <div class="logo-item" title="@team.Name"
                        data-team-id="@team.Id"
                        data-team-name="@team.Name">
                    <img src="@(string.IsNullOrEmpty(team.LogoUrl) ? Url.Content("~/images/logos/fallback.png") : team.LogoUrl)" alt="@team.Name" />
                    <span>@ShortTeamName(team.Name)</span>
                </div>
            }
        </div>

        <button class="carousel-btn right" type="button" aria-label="Défiler vers la droite">›</button>
    </div>
    <div id="teamFilterBar" class="mb-3" style="display:none">
        <span class="filter-badge">
            Équipe sélectionnée : <strong id="teamFilterName"></strong>
            <button id="clearTeamFilter" class="btn btn-sm btn-warning" type="button">Réinitialiser</button>
        </span>
    </div>
}

@if (Model.UpcomingGames?.Any() == true)
{
    <h2 class="h4 mb-3">Matchs à venir</h2>
    <div class="games-list">
        @foreach (var g in Model.UpcomingGames)
        {
            <div class="game-card"
                data-home-id="@g.HomeTeamId"
                data-away-id="@g.AwayTeamId"
                style="background-image:
                        linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,.55)),
                        url('@HomeHero(g)');">
            <div class="bg-away" style="background-image:url('@AwayHero(g)')"></div>

            <div class="teams">
                <div class="team home">
                <span class="name">@ShortTeamName(g.HomeTeam?.Name)</span>
                <img src="@(string.IsNullOrEmpty(g.HomeTeam?.LogoUrl) ? Url.Content("~/images/logos/fallback.png") : g.HomeTeam!.LogoUrl)" alt="@g.HomeTeam?.Name" />
                </div>
                <strong class="vs">vs</strong>
                <div class="team away">
                <span class="name">@ShortTeamName(g.AwayTeam?.Name)</span>
                <img src="@(string.IsNullOrEmpty(g.AwayTeam?.LogoUrl) ? Url.Content("~/images/logos/fallback.png") : g.AwayTeam!.LogoUrl)" alt="@g.AwayTeam?.Name" />
                </div>
            </div>

            <div class="meta">
                <span class="date">@g.StartAt.ToLocalTime().ToString("dddd d MMMM yyyy HH:mm")</span>
            </div>

            <a class="btn-reserve" asp-controller="Games" asp-action="Details" asp-route-id="@g.Id">Détails & Réserver</a>
            </div>
        }
    </div>
}
else
{
    <p>Aucun match à venir pour le moment.</p>
}

@if (Model.PastGames?.Any() == true)
{
    <h2 class="h4 mt-5 mb-3">Résultats récents</h2>
    <div class="games-list past">
        @foreach (var g in Model.PastGames)
        {
            <div class="game-card"
                data-home-id="@g.HomeTeamId"
                data-away-id="@g.AwayTeamId"
                 style="background-image:
                         linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,.55)),
                         url('@HomeHero(g)');">
                <div class="bg-away" style="background-image:url('@AwayHero(g)')"></div>

                <div class="teams">
                    <div class="team home">
                        <span class="name">@ShortTeamName(g.HomeTeam?.Name)</span>
                        <img src="@(string.IsNullOrEmpty(g.HomeTeam?.LogoUrl) ? Url.Content("~/images/logos/fallback.png") : g.HomeTeam!.LogoUrl)" alt="@g.HomeTeam?.Name" />
                    </div>

                    <strong class="vs">vs</strong>

                    <div class="team away">
                        <span class="name">@ShortTeamName(g.AwayTeam?.Name)</span>
                        <img src="@(string.IsNullOrEmpty(g.AwayTeam?.LogoUrl) ? Url.Content("~/images/logos/fallback.png") : g.AwayTeam!.LogoUrl)" alt="@g.AwayTeam?.Name" />
                    </div>
                </div>

                @* BLOC SCORE SOUS LES LOGOS *@
                @if (g.HomeScore.HasValue && g.AwayScore.HasValue)
                {
                    var winClass = g.HomeScore > g.AwayScore ? "home-win"
                                : g.HomeScore < g.AwayScore ? "away-win" : "draw";

                    <div class="scoreline @winClass">
                        <div class="score home">@g.HomeScore</div>
                        <div class="dash">–</div>
                        <div class="score away">@g.AwayScore</div>
                    </div>
                }

                <div class="meta">
                    <span class="date">@g.StartAt.ToLocalTime().ToString("dd'/'MM'/'yyyy")</span>
                </div>
                @* pas de bouton ici *@
            </div>
        }
    </div>
}



<script>
document.addEventListener('DOMContentLoaded', () => {
  const wrap = document.querySelector('.logo-carousel-wrapper');
  const scroller = wrap?.querySelector('#logoCarousel');
  const btnL = wrap?.querySelector('.carousel-btn.left');
  const btnR = wrap?.querySelector('.carousel-btn.right');
  if (!wrap || !scroller || !btnL || !btnR) return;

  const cell = () => (scroller.firstElementChild?.getBoundingClientRect().width || 132);
  const step = () => Math.max(Math.round(scroller.clientWidth * 0.8), Math.round(5 * cell()));

  const updateArrows = () => {
    const max = scroller.scrollWidth - scroller.clientWidth - 1;
    btnL.classList.toggle('is-disabled', scroller.scrollLeft <= 0);
    btnR.classList.toggle('is-disabled', scroller.scrollLeft >= max);
    btnL.setAttribute('aria-disabled', btnL.classList.contains('is-disabled'));
    btnR.setAttribute('aria-disabled', btnR.classList.contains('is-disabled'));
  };

  btnL.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
  btnR.addEventListener('click', () => scroller.scrollBy({ left:  step(), behavior: 'smooth' }));
  scroller.addEventListener('scroll', updateArrows, { passive: true });

  updateArrows();
});
document.addEventListener('DOMContentLoaded', () => {
  // --- Sélecteurs utiles
  const logoWrap = document.querySelector('.logo-carousel');
  const filterBar = document.getElementById('teamFilterBar');
  const filterName = document.getElementById('teamFilterName');
  const clearBtn = document.getElementById('clearTeamFilter');

  if (!logoWrap) return;

  // Toutes les cartes match (à venir + passés)
  const gameCards = Array.from(document.querySelectorAll('.games-list .game-card'));

  // Applique un filtre par teamId (number or string)
  function applyFilter(teamId, teamLabel) {
    // Visuel: logo actif
    logoWrap.querySelectorAll('.logo-item').forEach(li => {
      li.classList.toggle('active', li.dataset.teamId === String(teamId));
    });

    // Affiche la barre d’état
    filterBar.style.display = 'inline-block';
    filterName.textContent = teamLabel || '';

    // Hi-lite les matchs qui concernent l’équipe ; dimmer les autres
    gameCards.forEach(card => {
      const home = card.dataset.homeId;
      const away = card.dataset.awayId;
      const isTeamGame = (home === String(teamId) || away === String(teamId));
      card.classList.toggle('highlight', isTeamGame);
      card.classList.toggle('dimmed', !isTeamGame);
    });

    // Pour pouvoir deep-linker, on push l’état dans l’URL sans reload
    const url = new URL(window.location.href);
    url.searchParams.set('teamId', teamId);
    window.history.replaceState({}, '', url);
  }

  // Enlever tout filtre
  function clearFilter() {
    logoWrap.querySelectorAll('.logo-item').forEach(li => li.classList.remove('active'));
    filterBar.style.display = 'none';
    gameCards.forEach(card => {
      card.classList.remove('highlight', 'dimmed');
    });

    const url = new URL(window.location.href);
    url.searchParams.delete('teamId');
    window.history.replaceState({}, '', url);
  }

  // Clic sur un logo
  logoWrap.addEventListener('click', (e) => {
    const li = e.target.closest('.logo-item');
    if (!li) return;

    const id = li.dataset.teamId;
    const name = li.dataset.teamName;

    // toggle si on clique à nouveau sur le même logo
    if (li.classList.contains('active')) {
      clearFilter();
    } else {
      applyFilter(id, name);
    }
  });

  clearBtn?.addEventListener('click', clearFilter);

  // Si l’URL contient déjà teamId (partage / retour), on réapplique
  const init = new URL(window.location.href).searchParams.get('teamId');
  if (init) {
    const initLogo = logoWrap.querySelector(`.logo-item[data-team-id="${init}"]`);
    const initName = initLogo?.dataset.teamName || '';
    applyFilter(init, initName);
  }
});
</script>
<style>
  .game-card.dimmed { opacity: .25; filter: grayscale(40%); }
  .game-card.highlight { outline: 2px solid var(--orange); box-shadow: 0 0 0 3px rgba(255,140,0,.3); }
  .logo-item.active { transform: scale(1.06); outline: 2px solid var(--orange); border-radius: 8px; }
  .filter-badge { display:inline-flex; gap:.5rem; align-items:center; padding:.35rem .6rem; background: var(--card); border:1px solid var(--orange); border-radius:999px; }
</style>
