@using Microsoft.AspNetCore.Identity
@inject SignInManager<BasketWorld.Models.ApplicationUser> SignInManager
@inject UserManager<BasketWorld.Models.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="shortcut icon" href="@Url.Content("~/images/logo.png")" type="image/x-icon">
    <title>@ViewData["Title"] - BasketWorld</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <style>
    :root {
  --orange: #ff6a00;
  --orange-dark: #e15500;
  --bg: #fdf6ef;
  --card: #fff;
  --text: #1a1a1a;
  --white: #fff;
}

/* fond général */
body {
  background: url("/images/bg-basket.png") repeat;
  background-size: cover;
  background-attachment: fixed;
  color: var(--text);
  font-family: "Segoe UI", Oswald, sans-serif;
}

/* NAVBAR */
.bw-navbar {
  position: sticky;
  top: 0;
  z-index: 1030;
  background: linear-gradient(90deg, #ff6a00, #ff7a00);
  box-shadow: 0 4px 14px rgba(0,0,0,0.35);
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

/* logo BasketWorld */
.bw-logo {
  height: 64px;
  width: auto;
  transition: transform 0.2s ease;
}
/* mobile : légèrement plus petit */
@@media (max-width: 576px) {
  .bw-logo {
    height: 54px;
  }
}

/* liens centraux */
.bw-nav-links .nav-link {
  position: relative;
  margin: 0 0.35rem;
  padding: 0.3rem 0.9rem;
  border-radius: 999px;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #111 !important;
}

.bw-nav-links .nav-link:hover,
.bw-nav-links .nav-link:focus {
  background: rgba(0,0,0,0.08);
  text-decoration: none;
}

/* petit trait sous le lien actif au hover */
.bw-nav-links .nav-link::after {
  content: "";
  position: absolute;
  left: 18%;
  right: 18%;
  bottom: 0.2rem;
  height: 2px;
  background: rgba(0,0,0,0);
  border-radius: 999px;
  transition: background 0.2s;
}

.bw-nav-links .nav-link:hover::after {
  background: rgba(0,0,0,0.65);
}

/* zone utilisateur droite */
.bw-user-area .nav-item {
  display: flex;
  align-items: center;
}

/* badge crédits */
.bw-crédits-badge {
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.8rem;
  border-radius: 999px;
  background: rgba(0,0,0,0.16);
  color: #fff;
  font-weight: 600;
  font-size: 0.9rem;
}

/* boutons style pill */
.bw-btn-solid,
.bw-btn-outline,
.bw-btn-ghost {
  border-radius: 999px;
  font-weight: 600;
  padding: 0.35rem 1rem;
  font-size: 0.9rem;
}

/* bouton principal (Créer un compte) */
.bw-btn-solid {
  background: #111;
  border: 1px solid #111;
  color: #fff;
  :hover {
    border-color: #ffffff;
  }
}


/* bouton contour (Connexion / Déconnexion) */
.bw-btn-outline {
  background: transparent;
  border: 1px solid #111;
  color: #111;
}
.bw-btn-outline:hover {
  background: rgba(0,0,0,0.1);
}

/* bouton fantôme (Mes matchs) */
.bw-btn-ghost {
  background: rgba(0,0,0,0.12);
  border: 1px solid transparent;
  color: #fff;
}
.bw-btn-ghost:hover {
  background: rgba(0,0,0,0.22);
}

/* toggler mobile */
.navbar-toggler {
  padding: 0.25rem 0.5rem;
}
.navbar-toggler:focus {
  box-shadow: none;
}

.bw-nav-links .nav-link.active::after {
  background: #111; /* trait bien visible */
}
/* Liens */
a { color: var(--orange); }
a:hover { color: #d46a00; }

/* FOOTER BasketWorld (dark premium) */
.bw-footer{
  margin-top: 60px;
  background: linear-gradient(180deg, rgba(2,6,23,0.88), rgba(2,6,23,0.98));
  border-top: 1px solid rgba(255,255,255,0.10);
  box-shadow: 0 -20px 45px rgba(0,0,0,0.35);
  color: rgba(248,250,252,0.88);
}

.bw-footer-logo{
  height: 54px;
  width: auto;
  filter: drop-shadow(0 10px 18px rgba(0,0,0,0.35));
}

.bw-footer-title{
  font-weight: 900;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--orange, #ff6a00);
  line-height: 1.1;
}

.bw-footer-subtitle{
  font-size: .92rem;
  color: rgba(248,250,252,0.70);
}

.bw-footer-text{
  max-width: 520px;
  color: rgba(248,250,252,0.72);
  line-height: 1.5rem;
}

.bw-footer-col-title{
  font-weight: 800;
  letter-spacing: .02em;
  margin-bottom: .65rem;
  color: rgba(248,250,252,0.92);
}

.bw-footer-links{
  list-style: none;
  padding-left: 0;
  margin: 0;
  display: grid;
  gap: .45rem;
}

.bw-footer-links a{
  color: rgba(248,250,252,0.78);
  text-decoration: none;
}

.bw-footer-links a:hover{
  color: #fff;
  text-decoration: underline;
  text-decoration-color: rgba(255,106,0,0.85);
  text-underline-offset: 4px;
}

.bw-pill{
  display:inline-flex;
  align-items:center;
  gap:.35rem;
  padding:.28rem .75rem;
  border-radius: 999px;
  background: rgba(255,106,0,0.12);
  border: 1px solid rgba(255,106,0,0.22);
  color: rgba(255,220,190,0.95);
  font-weight: 700;
  font-size: .86rem;
}

.bw-top{
  margin-top: .8rem;
  border-radius: 999px;
  padding: .45rem .9rem;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.06);
  color: rgba(248,250,252,0.88);
  font-weight: 700;
}

.bw-top:hover{
  background: rgba(255,255,255,0.10);
}

.bw-footer-bottom{
  display:flex;
  justify-content: space-between;
  align-items:center;
  gap: 12px;
  border-top: 1px solid rgba(255,255,255,0.10);
  color: rgba(248,250,252,0.70);
  font-size: .92rem;
}

.bw-footer-mini{
  opacity: .9;
}

  </style>
</head>
<body>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentRouteName = ViewContext.RouteData.Values["name"]?.ToString();
}
<nav class="navbar navbar-expand-lg navbar-dark bw-navbar mb-4">
    <div class="container">
        <div class="align-items-center">
            <a class="navbar-brand align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="@Url.Content("~/images/logo.png")" alt="BasketWorld Logo"
                     class="bw-logo me-2" />
                <!--<span class="fw-bold">BasketWorld</span>-->
            </a>
        </div>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="nav" class="collapse navbar-collapse">
            <ul class="navbar-nav mx-auto bw-nav-links">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Leagues" && currentRouteName == "NBA" ? "active" : "")" asp-area="" asp-controller="Leagues" asp-action="Details" asp-route-name="NBA">NBA</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Leagues" && currentRouteName == "EuroLeague" ? "active" : "")" asp-area="" asp-controller="Leagues" asp-action="Details" asp-route-name="EuroLeague">EuroLeague</a>
                </li>
                <li class="nav-item @(currentController == "Shop" ? "active" : "")">
                    <a class="nav-link" asp-area="" asp-controller="Shop" asp-action="Index">Boutique</a>
                </li>
                <li class="nav-item @(currentController == "Standings" ? "active" : "")">
                  <a class="nav-link" asp-controller="Standings" asp-action="Index" asp-route-leagueName="NBA">Classement</a>
                </li>
            </ul>

            <ul class="navbar-nav align-items-center bw-user-area">
                @if (SignInManager.IsSignedIn(User))
                {
                    @* 🔐 BOUTON ADMIN *@
                    @if (User.IsInRole("admin"))
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-dark btn-sm fw-semibold"
                              asp-area="Admin"
                              asp-controller="Dashboard"
                              asp-action="Index">
                                🛠 Admin
                            </a>
                        </li>
                    }
                    var me = await UserManager.GetUserAsync(User);
                    <li class="nav-item me-3">
                        <span class="bw-crédits-badge">
                            @me?.crédits Crédit(s)
                        </span>
                    </li>
                    <li class="nav-item me-2">
                        <a class="btn bw-btn-ghost" asp-area="" asp-controller="Games" asp-action="Mine">
                            Mes matchs
                        </a>
                    </li>
                    <li class="nav-item">
                      <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index","Home", new { area = "" })" method="post" class="d-inline">
                        <button type="submit" class="btn bw-btn-outline">
                          Se déconnecter
                        </button>
                      </form>
                    </li>
                }
                else
                {
                    <li class="nav-item me-2">
                        <a class="btn bw-btn-outline" asp-area="Identity" asp-page="/Account/Login">Connexion</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn bw-btn-solid" asp-area="Identity" asp-page="/Account/Register">Créer un compte</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>


<main class="container">
  @RenderBody()
</main>

<footer class="bw-footer mt-5">
  <div class="container py-5">
    <div class="row g-4 align-items-start">

      <!-- Brand -->
      <div class="col-12 col-md-5">
        <div class="d-flex align-items-center gap-3 mb-3">
          <img src="@Url.Content("~/images/logo.png")" alt="BasketWorld" class="bw-footer-logo" />
          <div>
            <div class="bw-footer-title">BasketWorld</div>
            <div class="bw-footer-subtitle">NBA & EuroLeague • Réservation • Coins</div>
          </div>
        </div>

        <p class="bw-footer-text mb-3">
          Réserve tes places, gagne des crédits et regarde les matchs dès l’ouverture de la diffusion.
        </p>

        <div class="d-flex flex-wrap gap-2">
          <span class="bw-pill">🏀 Matchs</span>
          <span class="bw-pill">💰 Coins</span>
          <span class="bw-pill">📺 Live</span>
          <span class="bw-pill">📊 Classement</span>
        </div>
      </div>

      <!-- Links -->
      <div class="col-6 col-md-3">
        <div class="bw-footer-col-title">Navigation</div>
        <ul class="bw-footer-links">
          <li><a asp-area="" asp-controller="Home" asp-action="Index">Accueil</a></li>
          <li><a asp-area="" asp-controller="Leagues" asp-action="Details" asp-route-name="NBA">NBA</a></li>
          <li><a asp-area="" asp-controller="Leagues" asp-action="Details" asp-route-name="EuroLeague">EuroLeague</a></li>
          <li><a asp-area="" asp-controller="Shop" asp-action="Index">Boutique</a></li>
          <li><a asp-area="" asp-controller="Standings" asp-action="Index" asp-route-leagueName="NBA">Classement</a></li>
        </ul>
      </div>

      <!-- Help -->
      <div class="col-6 col-md-4">
        <div class="bw-footer-col-title">Infos</div>
        <ul class="bw-footer-links">
          <li><a asp-controller="Home" asp-action="Privacy">Conditions</a></li>
          <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
          @if (User.Identity?.IsAuthenticated ?? false)
          {
            <li><a asp-area="" asp-controller="Games" asp-action="Mine">Mes matchs</a></li>
          }
          @if (User.IsInRole("admin"))
          {
            <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
          }
        </ul>

        <button type="button" class="bw-top" onclick="window.scrollTo({top:0, behavior:'smooth'})">
          ↑ Retour en haut
        </button>
      </div>
    </div>

    <div class="bw-footer-bottom mt-4 pt-3">
      <div>© @DateTime.Now.Year BasketWorld</div>
      <div class="bw-footer-mini">
        Fait avec ❤️ pour les fans de basket
      </div>
    </div>
  </div>
</footer>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)

@{
    var toastType  = TempData["toast_type"] as string;
    var toastTitle = TempData["toast_title"] as string;
    var toastMsg   = TempData["toast_msg"] as string;
}

@if (!string.IsNullOrWhiteSpace(toastMsg))
{
    <div id="bwToast" class="bw-toast bw-toast-@toastType" role="status" aria-live="polite">
        <div class="bw-toast-icon">
            @if (toastType == "success") { <span>✓</span> }
            else if (toastType == "error") { <span>!</span> }
            else { <span>i</span> }
        </div>

        <div class="bw-toast-content">
            <div class="bw-toast-title">@toastTitle</div>
            <div class="bw-toast-msg">@toastMsg</div>
        </div>

        <button type="button" class="bw-toast-close" aria-label="Fermer">×</button>
    </div>

    <script>
        (function () {
            const toast = document.getElementById('bwToast');
            if (!toast) return;

            const closeBtn = toast.querySelector('.bw-toast-close');
            const hide = () => {
                toast.classList.add('hide');
                setTimeout(() => toast.remove(), 250);
            };

            closeBtn?.addEventListener('click', hide);
            setTimeout(() => toast.classList.add('show'), 50);
            setTimeout(hide, 4500);
        })();
    </script>
}

<style>
/* Toast BasketWorld */
.bw-toast{
    position: fixed;
    right: 18px;
    bottom: 18px;
    width: min(420px, calc(100vw - 36px));
    display: grid;
    grid-template-columns: 44px 1fr 32px;
    gap: 12px;
    align-items: center;

    padding: 14px 14px;
    border-radius: 16px;

    background: linear-gradient(180deg, #0f172a, #020617);
    border: 1px solid rgba(255,255,255,0.10);
    box-shadow: 0 20px 45px rgba(0,0,0,0.55);

    color: rgba(248,250,252,0.92);
    z-index: 9999;

    opacity: 0;
    transform: translateY(12px) scale(.98);
    transition: all .22s ease;
}

.bw-toast.show{
    opacity: 1;
    transform: translateY(0) scale(1);
}

.bw-toast.hide{
    opacity: 0;
    transform: translateY(12px) scale(.98);
}

.bw-toast-icon{
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight: 900;
    background: rgba(255,140,0,0.12);
    border: 1px solid rgba(255,140,0,0.25);
    color: var(--orange, #ff8c00);
}

.bw-toast-success .bw-toast-icon{
    background: rgba(34,197,94,0.12);
    border-color: rgba(34,197,94,0.25);
    color: #22c55e;
}

.bw-toast-error .bw-toast-icon{
    background: rgba(239,68,68,0.12);
    border-color: rgba(239,68,68,0.25);
    color: #ef4444;
}

.bw-toast-title{
    font-weight: 800;
    letter-spacing: .02em;
    margin-bottom: 2px;
}

.bw-toast-msg{
    font-size: .92rem;
    color: rgba(248,250,252,0.75);
    line-height: 1.25rem;
}

.bw-toast-close{
    width: 32px;
    height: 32px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.10);
    background: rgba(2,6,23,0.6);
    color: rgba(248,250,252,0.85);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
}

.bw-toast-close:hover{
    filter: brightness(1.08);
}

/* Mobile */
@@media (max-width: 520px){
    .bw-toast{ right: 12px; bottom: 12px; }
}
</style>

</body>
</html>