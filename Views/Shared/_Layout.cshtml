@using Microsoft.AspNetCore.Identity
@inject SignInManager<BasketWorld.Models.ApplicationUser> SignInManager
@inject UserManager<BasketWorld.Models.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - BasketWorld</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <style>
    :root {
      --orange: #ff6a00;
      --bg: #fdf6ef;           /* beige clair */
      --line: rgba(0,0,0,0.05);
      --card: #fff;
      --text: #1a1a1a;
      --white : #fff;
    }

    /* fond général : effet cuir basket léger */
    body {
      background: url("/images/bg-basket.png") repeat;
      background-size: cover;
      background-attachment: fixed;
      color: #1a1a1a;
      font-family: "Segoe UI", Roboto, sans-serif;
    }
    /* Navbar : orange NBA */
    .navbar {
      background: var(--orange);
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    .navbar .nav-link, .navbar-brand {
      color: #000 !important;
      font-weight: 600;
    }
    .navbar .nav-link:hover {
      text-decoration: underline;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
    }


    /* Boutons */
    .btn-warning, .btn-primary, .btn-success {
      background-color: var(--orange);
      border-color: var(--orange);
      color: #000;
    }
    .btn-warning:hover, .btn-primary:hover, .btn-success:hover {
      filter: brightness(1.05);
    }

    /* Liens */
    a { color: var(--orange); }
    a:hover { color: #d46a00; }

    /* Footer clair */
    footer {
      color: #444;
      border-top: 2px solid var(--orange);
    }
  </style>
</head>
<body>
<nav class="navbar navbar-expand-lg mb-4">
  <div class="container">
    <img src="@Url.Content("~/images/logo.png")" alt="BasketWorld Logo" style="height:60px; margin-right:10px;" />
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">BasketWorld</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div id="nav" class="collapse navbar-collapse">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
            <a class="nav-link"
              asp-area=""
              asp-controller="Home"
              asp-action="Index">Accueil</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
              asp-area=""
              asp-controller="Leagues"
              asp-action="Details"
              asp-route-name="NBA">NBA</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
              asp-area=""
              asp-controller="Leagues"
              asp-action="Details"
              asp-route-name="EuroLeague">EuroLeague</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
              asp-area=""
              asp-controller="Shop"
              asp-action="Index">Boutique</a>
        </li>
      </ul>
      <ul class="navbar-nav">
        @if (SignInManager.IsSignedIn(User))
        {
            var me = await UserManager.GetUserAsync(User);
            <li class="nav-item"><span class="navbar-text me-3">💰 @me?.Coins coin(s)</span></li>
            <li class="nav-item"><a class="nav-link" asp-controller="Games" asp-action="Mine">Mes matchs</a></li>
            <li class="nav-item">
                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Se déconnecter</button>
                </form>
            </li>
        }
        else
        {
            <li class="nav-item me-2"><a class="btn btn-outline-light btn-sm" asp-area="Identity" asp-page="/Account/Login">Connexion</a></li>
            <li class="nav-item"><a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Créer un compte</a></li>
        }
      </ul>
    </div>
  </div>
</nav>

<main class="container">
  @RenderBody()
</main>

<footer class="container mt-5 py-4 border-top">
  <div class="d-flex justify-content-between">
     <div>© @DateTime.Now.Year BasketWorld</div>
     <div>
       <a asp-controller="Home" asp-action="Privacy">Conditions</a> ·
       <a asp-controller="Home" asp-action="Contact">Contact</a>
     </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
