@page
@model RegisterModel
@{
    ViewData["Title"] = "Créer un compte";
}

<style>
    .auth-body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .auth-card {
        background: rgba(10, 10, 25, 0.94);
        border-radius: 24px;
        padding: 2.5rem;
        color: #f9fafb;
        max-width: 980px;
        width: 100%;
        box-shadow:
                0 24px 60px rgba(0, 0, 0, 0.55),
                0 0 0 1px rgba(255, 255, 255, 0.03);
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: 2.5rem;
    }

    .auth-brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.8rem;
    }

    .auth-logo {
        width: 40px;
        height: 40px;
        border-radius: 999px;
        background: radial-gradient(circle at 30% 30%, #ffe29f, #ffa99f 45%, #f12711 90%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
        font-weight: 800;
        color: #111827;
        font-size: 1.1rem;
    }

    .auth-brand-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #e5e7eb;
    }

    .auth-title {
        font-size: 1.9rem;
        font-weight: 800;
        margin-bottom: 0.4rem;
    }

    .auth-subtitle {
        font-size: 0.95rem;
        color: #9ca3af;
        margin-bottom: 1.8rem;
    }

    .auth-form-group {
        margin-bottom: 1rem;
    }

    .auth-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        font-weight: 600;
        color: #9ca3af;
        margin-bottom: 0.25rem;
        display: block;
    }

    .auth-input {
        background: rgba(15, 23, 42, 0.95);
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.45);
        padding: 0.55rem 1rem;
        color: #f9fafb;
        font-size: 0.95rem;
        width: 100%;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease, transform 0.08s ease;
    }

    .auth-input:focus {
        border-color: #f97316;
        box-shadow: 0 0 0 1px rgba(249, 115, 22, 0.65), 0 0 20px rgba(249, 115, 22, 0.3);
        background: rgba(15, 23, 42, 1);
        transform: translateY(-1px);
    }

    .auth-validation {
        color: #fca5a5;
        font-size: 0.8rem;
        margin-top: 0.15rem;
    }

    .auth-btn-primary {
        width: 100%;
        border-radius: 999px;
        border: none;
        padding: 0.65rem 1rem;
        margin-top: 0.6rem;
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: linear-gradient(135deg, #f97316, #facc15);
        color: #111827;
        box-shadow:
                0 18px 35px rgba(0, 0, 0, 0.6),
                0 0 0 1px rgba(248, 250, 252, 0.04);
        cursor: pointer;
        transition: transform 0.08s ease, box-shadow 0.12s ease, filter 0.1s ease;
    }

    .auth-btn-primary:hover {
        transform: translateY(-1px);
        filter: brightness(1.02);
        box-shadow:
                0 20px 40px rgba(0, 0, 0, 0.7),
                0 0 0 1px rgba(248, 250, 252, 0.1);
    }

    .auth-btn-primary:active {
        transform: translateY(0);
        box-shadow:
                0 12px 20px rgba(0, 0, 0, 0.5),
                0 0 0 1px rgba(248, 250, 252, 0.06);
    }

    .auth-meta {
        margin-top: 0.9rem;
        font-size: 0.83rem;
        color: #9ca3af;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .auth-meta a {
        color: #facc15;
        text-decoration: none;
        font-weight: 600;
    }

    .auth-meta a:hover {
        text-decoration: underline;
    }

    .auth-right {
        position: relative;
        border-radius: 20px;
        background: radial-gradient(circle at 10% 0, rgba(251, 191, 36, 0.26) 0, transparent 50%),
                    radial-gradient(circle at 100% 100%, rgba(96, 165, 250, 0.2) 0, transparent 55%),
                    linear-gradient(135deg, #020617, #020617);
        padding: 1.8rem;
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, 0.35);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.8rem;
    }

    .auth-right-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.3rem 0.8rem;
        border-radius: 999px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        border: 1px solid rgba(252, 211, 77, 0.5);
        color: #fef9c3;
        background: rgba(24, 24, 27, 0.7);
    }

    .auth-right-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-top: 0.8rem;
        margin-bottom: 0.4rem;
    }

    .auth-right-text {
        font-size: 0.9rem;
        color: #e5e7eb;
        max-width: 260px;
    }

    .auth-stat-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
        margin-top: 1.1rem;
    }

    .auth-stat-card {
        background: radial-gradient(circle at top, rgba(55, 65, 81, 0.6), rgba(17, 24, 39, 0.95));
        border-radius: 16px;
        padding: 0.7rem 0.85rem;
        border: 1px solid rgba(75, 85, 99, 0.7);
        backdrop-filter: blur(6px);
    }

    .auth-stat-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #9ca3af;
        margin-bottom: 0.1rem;
    }

    .auth-stat-value {
        font-size: 1.1rem;
        font-weight: 800;
        color: #facc15;
    }

    .auth-footer-note {
        font-size: 0.75rem;
        color: #9ca3af;
        opacity: 0.9;
    }

    .text-danger ul {
        margin-bottom: 0;
        padding-left: 1.1rem;
    }
</style>

<div class="auth-body">
    <div class="auth-card">
        <!-- Colonne gauche : formulaire -->
        <div>
            <div class="auth-brand">
                <div class="auth-logo">
                    BW
                </div>
                <div>
                    <div class="auth-brand-title">BasketWorld</div>
                    <div style="font-size:0.75rem; color:#9ca3af;">Rejoignez la ligue</div>
                </div>
            </div>

            <h1 class="auth-title">Créer un compte</h1>
            <p class="auth-subtitle">
                Réservez des places NBA & EuroLeague, collectionnez des coins et suivez vos matchs favoris.
            </p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="auth-form-group">
                    <label asp-for="Input.Email" class="auth-label"></label>
                    <input asp-for="Input.Email" class="auth-input" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="auth-validation"></span>
                </div>

                <div class="auth-form-group">
                    <label asp-for="Input.Password" class="auth-label"></label>
                    <input asp-for="Input.Password" class="auth-input" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="auth-validation"></span>
                </div>

                <div class="auth-form-group">
                    <label asp-for="Input.ConfirmPassword" class="auth-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="auth-input" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.ConfirmPassword" class="auth-validation"></span>
                </div>

                <button id="registerSubmit" type="submit" class="auth-btn-primary">
                    Créer mon compte
                </button>

                <div class="auth-meta">
                    <span>Déjà un compte ? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Se connecter</a></span>
                </div>
            </form>
        </div>

        <!-- Colonne droite : "hero" BasketWorld -->
        <div class="auth-right">
            <div>
                <span class="auth-right-badge">
                    ● Courts en direct
                </span>
                <h2 class="auth-right-title">Une arène toujours ouverte.</h2>
                <p class="auth-right-text">
                    Retrouve les affiches NBA et EuroLeague, réserve ta place virtuelle et accumule des coins
                    à chaque réservation.
                </p>

                <div class="auth-stat-grid">
                    <div class="auth-stat-card">
                        <div class="auth-stat-label">Matches cette semaine</div>
                        <div class="auth-stat-value">+32</div>
                    </div>
                    <div class="auth-stat-card">
                        <div class="auth-stat-label">Fans inscrits</div>
                        <div class="auth-stat-value">12k</div>
                    </div>
                    <div class="auth-stat-card">
                        <div class="auth-stat-label">Coins de bienvenue</div>
                        <div class="auth-stat-value">+100</div>
                    </div>
                    <div class="auth-stat-card">
                        <div class="auth-stat-label">Ligues suivies</div>
                        <div class="auth-stat-value">NBA · EL</div>
                    </div>
                </div>
            </div>

            <div class="auth-footer-note">
                Tu pourras gérer ton profil, tes réservations et ton solde de coins à tout moment depuis ton espace BasketWorld.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
