@* Views/Games/Details.cshtml *@
@model Game
@{
    string ShortTeamName(string? raw)
    {
      if (string.IsNullOrWhiteSpace(raw)) return "";

      return raw.ToUpperInvariant() switch
      {
          "ANADOLU EFES ISTANBUL" => "Anadolu",
          "AS MONACO" => "Monaco",
          "KOSNER BASKONIA VITORIA-GASTEIZ" => "Baskonia",
          "FC BAYERN MUNICH" => "Bayern",
          "ZALGIRIS KAUNAS" => "Zalgiris",
          "FC BARCELONA" => "Barcelona",
          "DUBAI BASKETBALL" => "Dubai",
          "FENERBAHCE BEKO ISTANBUL" => "Fenerbahce",
          "HAPOEL IBI TEL AVIV" => "Hapoel",
          "PARTIZAN MOZZART BET BELGRADE" => "Partizan",
          "LDLC ASVEL VILLEURBANNE" => "ASVEL",
          "MACCABI RAPYD TEL AVIV" => "Maccabi",
          "EA7 EMPORIO ARMANI MILAN" => "Milano", // ou "Olimpia Milano"
          "OLYMPIACOS PIRAEUS" => "Olympiacos",
          "PANATHINAIKOS AKTOR ATHENS" => "Panathinaikos",
          "CRVENA ZVEZDA MERIDIANBET BELGRADE" => "Crvena",
          "PARIS BASKETBALL" => "Paris",
          "REAL MADRID" => "Real Madrid",
          "VALENCIA BASKET" => "Valencia",
          "VIRTUS BOLOGNA" => "Bologna",
          "MERIDIANS" => "Meridians",
          _ => raw
      };
    }
    ViewData["Title"] = "Détails du match";

    var hasAccess = (bool)(ViewBag.HasAccess ?? false);
    var canWatchFromUtc = (DateTime)(ViewBag.CanWatchFromUtc ?? Model.StartAt);
    var canWatchFromLocal = canWatchFromUtc.ToLocalTime();
    bool canWatchNow = DateTime.UtcNow >= canWatchFromUtc;

    var homeName = @ShortTeamName(Model.HomeTeam?.Name) ?? "Équipe A";
    var awayName = @ShortTeamName(Model.AwayTeam?.Name) ?? "Équipe B";

    var homeLogo = Url.Content(Model.HomeTeam?.LogoUrl ?? "~/images/logos/default.png");
    var awayLogo = Url.Content(Model.AwayTeam?.LogoUrl ?? "~/images/logos/default.png");

    bool isFinal = string.Equals(Model.Status, "Final", StringComparison.OrdinalIgnoreCase);
    bool hasScore = Model.HomeScore.HasValue && Model.AwayScore.HasValue;
}

<div class="game-page">
    <div class="game-card shadow-lg">

        <!-- Header -->
        <div class="game-hero">
            <div class="hero-top">
                <span class="badge-pill">@Model.League?.Name</span>
                <span class="dot">•</span>
                <span class="muted">@Model.StartAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                @if (!string.IsNullOrWhiteSpace(Model.Venue))
                {
                    <span class="dot">•</span>
                    <span class="muted">@Model.Venue</span>
                }
            </div>

            <div class="hero-main">
                <div class="team-side">
                    <img class="team-logo"
                         src="@homeLogo"
                         alt="@homeName"
                         onerror="this.onerror=null;this.src='@Url.Content("~/images/logos/default.png")';" />
                    <div class="team-name" title="@Model.HomeTeam?.Name">@homeName</div>
                </div>

                <div class="center-vs">
                    @if (hasScore && isFinal)
                    {
                        <div class="score">
                            <span class="score-num">@Model.HomeScore</span>
                            <span class="score-sep">-</span>
                            <span class="score-num">@Model.AwayScore</span>
                        </div>
                        <div class="status-badge status-final">Final</div>
                    }
                    else
                    {
                        <div class="vs">VS</div>
                    }
                </div>

                <div class="team-side">
                    <img class="team-logo"
                         src="@awayLogo"
                         alt="@awayName"
                         onerror="this.onerror=null;this.src='@Url.Content("~/images/logos/default.png")';" />
                    <div class="team-name" title="@Model.AwayTeam?.Name">@awayName</div>
                </div>
            </div>

            <div class="hero-bottom">
                <div class="mini-info">
                    <div class="mini-label">Diffusion</div>
                    <div class="mini-value">à partir du @canWatchFromLocal.ToString("dd/MM/yyyy HH:mm")</div>
                </div>

                <div class="mini-info">
                    <div class="mini-label">Accès</div>
                    <div class="mini-value">
                        @(User.Identity?.IsAuthenticated == true ? (hasAccess ? "Réservé ✔" : "Non réservé") : "Connexion requise")
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="game-body">

            @if (!User.Identity.IsAuthenticated)
            {
                <div class="notice notice-info">
                    <div class="notice-title">Connexion requise</div>
                    <div class="notice-text">Connecte-toi pour réserver ce match (1 coin).</div>
                </div>

                <a class="btn bw-btn bw-btn-primary"
                   asp-area="Identity" asp-page="/Account/Login">
                    Se connecter
                </a>
            }
            else if (!hasAccess)
            {
                <div class="notice notice-warn">
                    <div class="notice-title">Réservation</div>
                    <div class="notice-text">Réserve ta place pour accéder à la diffusion.</div>
                </div>

                <form method="post" asp-action="BuyAccess" asp-route-id="@Model.Id" class="d-grid gap-2">
                    <button class="btn bw-btn bw-btn-orange" type="submit">
                        🎟️ Réserver ma place (1 coin)
                    </button>
                </form>

                <div class="muted mt-2">
                    La diffusion ouvre le @canWatchFromLocal.ToString("dd/MM/yyyy HH:mm").
                </div>
            }
            else
            {
                if (canWatchNow)
                {
                    <div class="notice notice-ok">
                        <div class="notice-title">Réservation confirmée ✔</div>
                        <div class="notice-text">La diffusion est disponible.</div>
                    </div>

                    <a class="btn bw-btn bw-btn-green"
                       asp-action="Watch" asp-route-id="@Model.Id">
                        ▶ Regarder le match
                    </a>
                }
                else
                {
                    <div class="notice notice-ok">
                        <div class="notice-title">Réservation confirmée ✔</div>
                        <div class="notice-text">La diffusion ouvrira le @canWatchFromLocal.ToString("dd/MM/yyyy HH:mm").</div>
                    </div>

                    <button id="watchBtn" class="btn bw-btn bw-btn-green" disabled>
                        ▶ Regarder le match
                    </button>

                    <div class="countdown" id="countdown"></div>

                    <script>
                        (function () {
                            const target = new Date('@canWatchFromLocal.ToString("yyyy-MM-ddTHH:mm:ss")');
                            const btn = document.getElementById('watchBtn');
                            const cd = document.getElementById('countdown');

                            function tick() {
                                const now = new Date();
                                const diff = target - now;

                                if (diff <= 0) {
                                    btn.disabled = false;
                                    btn.onclick = () => { window.location = '@Url.Action("Watch", "Games", new { id = Model.Id })'; };
                                    cd.textContent = "C'est parti !";
                                    cd.classList.add("live");
                                    clearInterval(intv);
                                } else {
                                    const s = Math.floor(diff / 1000) % 60;
                                    const m = Math.floor(diff / 60000) % 60;
                                    const h = Math.floor(diff / 3600000);
                                    cd.textContent = `Disponible dans ${h}h ${m}m ${s}s`;
                                }
                            }

                            tick();
                            const intv = setInterval(tick, 1000);
                        })();
                    </script>
                }
            }

            <div class="mt-4 d-flex justify-content-center">
                <a class="btn bw-btn bw-btn-outline"
                   asp-controller="Home" asp-action="Index">
                    ⬅ Retour à l’accueil
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    :root { --orange: var(--orange, #ff8c00); }

    .game-page{
        min-height: calc(100vh - 120px);
        display:flex;
        align-items:center;
        justify-content:center;
        padding: 2rem 1rem;
    }

    .game-card{
        width: 100%;
        max-width: 1050px;
        border-radius: 1.5rem;
        overflow:hidden;
        background: #0b1120;
        color: #f8f9fa;
        border: 1px solid rgba(255,255,255,.08);
    }

    /* HERO */
    .game-hero{
        position:relative;
        padding: 1.75rem 1.75rem 1.25rem;
        background: linear-gradient(135deg, #111827, #0b1220 55%, #1f2937);
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .game-hero::before{
        content:"";
        position:absolute;
        inset:0;
        background-image:
            radial-gradient(circle at 10% 10%, rgba(255,140,0,.20) 0, transparent 55%),
            radial-gradient(circle at 85% 90%, rgba(59,130,246,.18) 0, transparent 55%);
        pointer-events:none;
        opacity:.9;
    }

    .hero-top{
        position:relative;
        z-index:1;
        display:flex;
        flex-wrap:wrap;
        gap:.6rem;
        align-items:center;
        font-size:.95rem;
    }

    .badge-pill{
        background: rgba(255,140,0,.14);
        border: 1px solid rgba(255,140,0,.35);
        color: #ffd6a5;
        padding: .35rem .7rem;
        border-radius: 999px;
        font-weight: 700;
        letter-spacing: .03em;
        text-transform: uppercase;
        font-size: .78rem;
    }

    .dot{ opacity:.6; }
    .muted{ color: rgba(249,250,251,.75); }

    .hero-main{
        position:relative;
        z-index:1;
        margin-top: 1.4rem;
        display:grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1rem;
        align-items:center;
    }

    .team-side{
        display:flex;
        align-items:center;
        gap: 1rem;
        min-width: 0;
    }

    .team-side:last-child{
        justify-content:flex-end;
        text-align:right;
    }

    .team-logo{
        width: 78px;
        height: 78px;
        object-fit: contain;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 1rem;
        padding: .55rem;
    }

    .team-name{
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: .01em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 360px;
    }

    .center-vs{
        text-align:center;
        min-width: 150px;
    }

    .vs{
        font-weight: 900;
        letter-spacing: .25em;
        color: rgba(255,255,255,.7);
        font-size: 1.1rem;
    }

    .score{
        font-size: 2.3rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: .25rem;
    }
    .score-num{ color: #fff; }
    .score-sep{ color: rgba(255,255,255,.35); padding: 0 .25rem; }

    .status-badge{
        display:inline-block;
        padding: .25rem .65rem;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 700;
        border: 1px solid rgba(255,255,255,.10);
    }
    .status-final{
        background: rgba(16,185,129,.14);
        border-color: rgba(16,185,129,.30);
        color: #bbf7d0;
    }
    .status-upcoming{
        background: rgba(148,163,184,.12);
        border-color: rgba(148,163,184,.22);
        color: rgba(249,250,251,.85);
    }

    .hero-bottom{
        position:relative;
        z-index:1;
        margin-top: 1.25rem;
        display:grid;
        grid-template-columns: 1fr 1fr;
        gap: .9rem;
    }

    .mini-info{
        background: rgba(15,23,42,.55);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 1rem;
        padding: .85rem 1rem;
    }
    .mini-label{
        font-size: .75rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: rgba(209,213,219,.75);
        margin-bottom: .25rem;
        font-weight: 700;
    }
    .mini-value{
        font-weight: 650;
        color: rgba(249,250,251,.9);
    }

    /* BODY */
    .game-body{
        padding: 1.6rem 1.75rem 1.8rem;
        background: #0b1120;
    }

    .notice{
        border-radius: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid rgba(255,255,255,.08);
        margin-bottom: 1rem;
        background: rgba(15,23,42,.55);
    }
    .notice-title{ font-weight: 800; margin-bottom: .2rem; }
    .notice-text{ color: rgba(249,250,251,.82); }

    .notice-info{
        border-color: rgba(59,130,246,.25);
        background: rgba(59,130,246,.10);
    }
    .notice-warn{
        border-color: rgba(255,140,0,.25);
        background: rgba(255,140,0,.12);
    }
    .notice-ok{
        border-color: rgba(16,185,129,.25);
        background: rgba(16,185,129,.10);
    }

    .bw-btn{
        border-radius: 999px;
        font-weight: 800;
        padding: .75rem 1rem;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .bw-btn-primary{
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
    }
    .bw-btn-primary:hover{ filter: brightness(1.05); color:#fff; }

    .bw-btn-orange{
        background: var(--orange);
        border-color: var(--orange);
        color: #fff;
    }
    .bw-btn-orange:hover{ filter: brightness(1.05); color:#fff; }

    .bw-btn-green{
        background: #10b981;
        border-color: #10b981;
        color: #082015;
    }
    .bw-btn-green:hover{ filter: brightness(1.05); color:#082015; }

    .bw-btn-outline{
        background: transparent;
        border: 1px solid rgba(255,140,0,.55);
        color: #ffd6a5;
    }
    .bw-btn-outline:hover{
        background: rgba(255,140,0,.10);
        color: #ffd6a5;
    }

    .countdown{
        margin-top: .85rem;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding: .55rem .9rem;
        border-radius: 999px;
        background: rgba(255,140,0,.12);
        border: 1px solid rgba(255,140,0,.25);
        color: #ffd6a5;
        font-weight: 800;
        letter-spacing: .02em;
    }
    .countdown.live{
        background: rgba(16,185,129,.12);
        border-color: rgba(16,185,129,.30);
        color: #bbf7d0;
    }

    @@media (max-width: 900px){
        .hero-main{ grid-template-columns: 1fr; gap: .9rem; }
        .center-vs{ order: -1; }
        .team-side, .team-side:last-child{ justify-content:center; text-align:center; }
        .team-name{ max-width: 100%; }
        .hero-bottom{ grid-template-columns: 1fr; }
        .team-logo{ width:72px; height:72px; }
    }
</style>
